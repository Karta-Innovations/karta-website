# Karta website environment configuration
#
# Copy to `.env.local` for local development.
# Set in Vercel / your host's environment for production.

# Public site URL — used in metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://karta.ai

# Engage form (POST /api/engage) destination.
# If either of these is missing, the route still validates payloads
# and acknowledges submissions, but only logs them locally instead of
# delivering via Resend.
ENGAGE_TO_EMAIL=info@kartainnovations.com
RESEND_API_KEY=
